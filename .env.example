# Environment configuration
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reports_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reports_db
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_MANAGEMENT_PORT=15672

# Storage
STORAGE_DIR=./storage/reports

# Worker Settings
WORKER_DELAY_SECONDS=5
WORKER_ID=worker-1
MAX_RETRIES=3

# Testing Simulation Flags
SIMULATE_TRANSIENT_ERROR=false
SIMULATE_PERMANENT_ERROR=false
